{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robertschaub.github.io/ai-charter-runtime/m6/schema/offline-matrix-v1.json",
  "title": "M6 bounded offline result matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capture_id", "attempt_id", "plan_digest", "layer", "results", "comparisons", "summary"],
  "properties": {
    "schema_version": { "const": "m6-offline-matrix/v1" },
    "capture_id": { "$ref": "#/$defs/captureId" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "plan_digest": { "$ref": "#/$defs/digest" },
    "layer": { "const": "offline-fixture" },
    "results": { "type": "array", "minItems": 123, "maxItems": 123, "items": { "$ref": "#/$defs/result" } },
    "comparisons": { "type": "array", "minItems": 57, "maxItems": 57, "items": { "$ref": "#/$defs/comparison" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "captureId": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$)[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "card_version", "card_digest", "requested_id"],
      "properties": {
        "card_id": { "type": "string", "minLength": 1 },
        "card_version": { "type": "integer", "minimum": 1 },
        "card_digest": { "$ref": "#/$defs/digest" },
        "requested_id": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "verdict", "matched_rule_id", "ux_class"],
      "properties": {
        "name": { "enum": ["authorize", "submit", "verify", "commit", "rely"] },
        "verdict": { "enum": ["allow", "deny", "escalate"] },
        "matched_rule_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "ux_class": { "enum": ["silent", "flag", "stop"] }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "eligible_role", "permitted_dispositions", "terminal_disposition"],
      "properties": {
        "trigger": { "type": "string", "minLength": 1 },
        "eligible_role": { "type": "string", "minLength": 1 },
        "permitted_dispositions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "terminal_disposition": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "observed"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "observed": { "anyOf": [{ "type": "boolean" }, { "type": "integer" }, { "type": "string" }, { "type": "null" }] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "case_id", "class", "lane_slot", "selected_card", "gates", "intervention", "commitment_state", "effect_count", "failure_class", "containment_class", "coverage", "mechanism", "observed_assertions"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^m6:(?:beat-[0-9]{2}|adv-[a-z0-9-]+|infra-[a-z0-9-]+):(?:lane-[01]|single)$" },
        "case_id": { "type": "string", "pattern": "^(?:beat-[0-9]{2}|adv-[a-z0-9-]+|infra-[a-z0-9-]+)$" },
        "class": { "enum": ["beat", "adversarial", "infrastructure"] },
        "lane_slot": { "enum": ["lane-0", "lane-1", "single"] },
        "selected_card": { "anyOf": [{ "$ref": "#/$defs/card" }, { "type": "null" }] },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "intervention": { "anyOf": [{ "$ref": "#/$defs/intervention" }, { "type": "null" }] },
        "commitment_state": { "enum": ["none", "blocked", "prepared", "committed", "already_bound"] },
        "effect_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "failure_class": { "anyOf": [{ "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }, { "type": "null" }] },
        "containment_class": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "coverage": { "enum": ["exercised", "partial", "not_assessed", "not_applicable"] },
        "mechanism": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,159}$" },
        "observed_assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "mode", "lane_0_digest", "lane_1_digest", "outcome_equal", "status", "reason"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^(?:beat-[0-9]{2}|adv-[a-z0-9-]+)$" },
        "mode": { "enum": ["invariant", "provider_specific"] },
        "lane_0_digest": { "$ref": "#/$defs/digest" },
        "lane_1_digest": { "$ref": "#/$defs/digest" },
        "outcome_equal": { "type": "boolean" },
        "status": { "const": "pass" },
        "reason": { "enum": ["invariant_outcome", "expected_provider_permission_difference"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_count", "comparison_count", "failed_count", "indeterminate_count"],
      "properties": {
        "result_count": { "const": 123 },
        "comparison_count": { "const": 57 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "indeterminate_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
