{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robertschaub.github.io/ai-charter-runtime/m6/schema/capture-manifest-v1.json",
  "title": "M6 bounded capture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capture_id", "plan_digest", "layer", "artifacts", "attempt_summary", "publication_state"],
  "properties": {
    "schema_version": { "const": "m6-capture-manifest/v1" },
    "capture_id": { "$ref": "#/$defs/id" },
    "plan_digest": { "$ref": "#/$defs/digest" },
    "layer": { "enum": ["dry-run", "offline-fixture"] },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "attempt_summary": { "$ref": "#/$defs/summary" },
    "publication_state": { "const": "staged-not-published" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "sha256", "byte_length"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*\\.json$" },
        "schema_version": { "enum": ["m6-attempt-events/v1", "m6-capture-plan/v1", "m6-offline-matrix/v1", "m6-sanitization-report/v1"] },
        "sha256": { "$ref": "#/$defs/digest" },
        "byte_length": { "type": "integer", "minimum": 2 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "complete", "failed", "indeterminate"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "complete": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "indeterminate": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
