{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robertschaub.github.io/ai-charter-runtime/m6/schema/attempt-events-v1.json",
  "title": "M6 append-only attempt lifecycle events",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capture_id", "events"],
  "properties": {
    "schema_version": { "const": "m6-attempt-events/v1" },
    "capture_id": { "$ref": "#/$defs/id" },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "attempt_id", "layer", "state", "recorded_at", "failure_class"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "attempt_id": { "$ref": "#/$defs/id" },
        "layer": { "enum": ["dry-run", "live", "offline-fixture"] },
        "state": { "enum": ["planned", "preflighted", "running", "complete", "failed", "indeterminate", "sanitized", "reviewed-for-publication"] },
        "recorded_at": { "type": "string", "format": "date-time" },
        "failure_class": { "anyOf": [{ "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }, { "type": "null" }] }
      }
    }
  }
}
