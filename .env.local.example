# Copy to .env.local (gitignored). Keys and tokens never enter git, logs, or records.

# --- model lanes ---
PUBLICAI_API_KEY=            # self-issue at platform.publicai.co (wallet-credit metered)
OPENAI_API_KEY=
# PUBLICAI_BASE_URL=https://api.publicai.co/v1
# PUBLICAI_MODEL=swiss-ai/apertus-v1.5-70b
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.5

# --- runtime topology (ADR-002) ---
# RUNTIME_HOST=127.0.0.1
# AUTHZ_PORT=7801
# ORCHESTRATOR_PORT=7802
# SERVICES_PORT=7803
# DEMO_WORLD_ID=w-demo

# --- credentials (ADR-002): 32 random bytes hex each, all mutually distinct;
# --- generate with tooling/keys.mjs; startup fails closed on missing/short/duplicate
AUTHZ_TOKEN_PRINCIPAL=
AUTHZ_TOKEN_CASE_OFFICER=
AUTHZ_TOKEN_APPLICANT=
AUTHZ_TOKEN_PROC_ORCHESTRATOR=
AUTHZ_TOKEN_PROC_SERVICES_HOST=
SERVICES_TOKEN_PROC_AUTHZ=

# The runtime supervisor derives two narrower, one-way audience credentials in memory:
# ORCHESTRATOR_TOKEN_CASE_OFFICER and SERVICES_TOKEN_PROC_ORCHESTRATOR. They are passed
# only to their target child processes and are not stored in this file.

# --- integrity keys (ADR-007) ---
GATE_HMAC_KEY=               # 32 bytes hex
GATE_HMAC_KEY_ID=hmac-2026-08-01
